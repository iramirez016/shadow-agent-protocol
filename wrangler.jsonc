{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadow-agent-protocol",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-12",
  "observability": {
    "enabled": true
  },
  // Set GOOGLE_CLIENT_ID to the OAuth web client ID in each Cloudflare environment.
  // Also copy that public ID into index.html's google-client-id meta tag for GIS.
  // Register the GitHub Pages, Worker, localhost:8000, and localhost:8787 origins in Google Cloud.
  "vars": {
    "GOOGLE_CLIENT_ID": "643701041191-egcdurbar615dnlrk4crg5s27jh9aglq.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "previews": {}
}
